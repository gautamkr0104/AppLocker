<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/policy_title"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.9"
            android:text="@string/policy_subtitle"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="8dp">

                <RadioGroup
                    android:id="@+id/policy_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/policy_immediate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="@string/policy_immediate"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/policy_screen_off"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="@string/policy_screen_off"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/policy_timeout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="@string/policy_timeout"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/policy_session"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="@string/policy_session"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </RadioGroup>
            </LinearLayout>

            <TextView
                android:id="@+id/timeout_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="6dp"
                android:text="@string/timeout_label"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/timeout_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:importantForAutofill="no"
                android:inputType="number"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/policy_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:minHeight="52dp"
                android:text="@string/policy_save"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/policy_back"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:minHeight="48dp"
                android:text="@string/policy_back"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
