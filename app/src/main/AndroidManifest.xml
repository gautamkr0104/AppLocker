<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Signature permission gating config/grant IPC between manager and system_server hooks.
         No accessibility, notification-listener, usage-access, or foreground-service permissions. -->
    <permission
        android:name="com.applocker.permission.INTERNAL"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.applocker.permission.INTERNAL" />

    <!-- Package visibility: only query launchable (launcher) apps. No QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_lock"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- LSPosed/Xposed module metadata (legacy module format, supported by LSPosed) -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="System-level PIN/password AppLocker (Android 13 / One UI)" />
        <meta-data android:name="xposedminversion" android:value="93" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.AppListActivity" android:exported="false" />
        <activity android:name=".ui.PolicyActivity" android:exported="false" />
        <activity android:name=".ui.DiagnosticsActivity" android:exported="false" />

        <!-- Authentication screen. Exported=false: only same-uid or system can start it;
             extra validation on launch origin is done in code. -->
        <activity
            android:name=".ui.AuthActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:noHistory="false"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AuthTheme" />

        <!-- IPC surface for the system_server hook side. Caller-uid validated in code. -->
        <provider
            android:name=".provider.LockerProvider"
            android:authorities="com.applocker.provider"
            android:exported="true"
            android:grantUriPermissions="false" />

    </application>
</manifest>
